# Google Maps API
# Get your API key from: https://console.cloud.google.com
# Make sure to enable: Maps JavaScript API, Directions API, Geocoding API, Places API
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_public_google_maps_api_key_here
NUXT_GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# Supabase Configuration (for traffic reports database)
# Get these from: https://app.supabase.com
NUXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
