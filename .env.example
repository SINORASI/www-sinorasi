# Mapbox API Configuration
# Get your Mapbox access token from: https://account.mapbox.com/tokens/

# Public Mapbox token (for client-side geocoding and mapping)
NUXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Server-side Mapbox token (for server-side routing and geocoding)
MAPBOX_TOKEN=your_mapbox_private_token_here
